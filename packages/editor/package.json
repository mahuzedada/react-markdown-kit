{
  "name": "@react-markdown-kit/editor",
  "version": "0.1.0",
  "description": "Rich, source and preview Markdown editing for React. Markdown in, Markdown out.",
  "homepage": "https://docs.reactmarkdownkit.com/react-markdown-editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahuzedada/react-markdown-kit.git",
    "directory": "packages/editor"
  },
  "bugs": "https://github.com/mahuzedada/react-markdown-kit/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lexical": {
      "types": "./dist/lexical.d.ts",
      "default": "./dist/lexical.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@lexical/headless": "^0.35.0",
    "@lexical/history": "^0.35.0",
    "@lexical/rich-text": "^0.35.0",
    "@lexical/selection": "^0.35.0",
    "@lexical/utils": "^0.35.0",
    "lexical": "^0.35.0",
    "mdast-util-to-markdown": "^2.1.2"
  },
  "peerDependencies": {
    "@react-markdown-kit/renderer": "^0.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "keywords": [
    "react",
    "markdown",
    "editor",
    "wysiwyg",
    "lexical",
    "rich-text",
    "markdown-editor",
    "round-trip",
    "react-markdown-editor"
  ],
  "devDependencies": {
    "@react-markdown-kit/renderer": "workspace:*",
    "@types/mdast": "^4.0.4"
  }
}
