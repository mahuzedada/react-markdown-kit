{
  "name": "reactmarkdownkit",
  "buildCommand": "pnpm install --frozen-lockfile && pnpm build && pnpm build:site",
  "context": ".",
  "dockerfile": "Dockerfile",
  "composeFile": "compose.yml",
  "nginxFile": "nginx.shipiru.conf",
  "nginxSite": "reactmarkdownkit",
  "container": "reactmarkdownkit",
  "healthPath": "/",
  "routeChecks": [
    {
      "url": "https://reactmarkdownkit.com/",
      "status": 200
    },
    {
      "url": "https://reactmarkdownkit.com/docs/guides/markdown-variables",
      "status": 200
    },
    {
      "url": "https://reactmarkdownkit.com/mermaid-editor",
      "status": 200
    },
    {
      "url": "https://reactmarkdownkit.com/markdown-template-engine",
      "status": 200,
      "contains": "https://reactmarkdownkit.com/markdown-variables"
    },
    {
      "url": "https://docs.reactmarkdownkit.com/edit-ai-generated-mermaid",
      "status": 200,
      "contains": "https://reactmarkdownkit.com/edit-ai-generated-mermaid"
    },
    {
      "url": "https://www.reactmarkdownkit.com/",
      "status": 200
    },
    {
      "url": "https://mermaid.reactmarkdownkit.com/",
      "status": 200,
      "contains": "https://reactmarkdownkit.com/mermaid-editor"
    },
    {
      "url": "https://slides.reactmarkdownkit.com/",
      "status": 200,
      "contains": "https://reactmarkdownkit.com/markdown-slides"
    },
    {
      "url": "https://renderer.reactmarkdownkit.com/",
      "status": 200,
      "contains": "https://reactmarkdownkit.com/markdown-renderer"
    },
    {
      "url": "https://editor.reactmarkdownkit.com/",
      "status": 200,
      "contains": "https://reactmarkdownkit.com/markdown-editor"
    }
  ]
}
