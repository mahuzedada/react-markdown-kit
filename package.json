{
  "name": "react-markdown-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './plugins/*' build",
    "build:sites": "pnpm -r --filter './public-sites/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "bench": "node benchmarks/run.mjs",
    "seo:report": "node scripts/seo-report.mjs",
    "size:mermaid": "node scripts/mermaid-size.mjs",
    "size:bundles": "node scripts/compare-bundles.mjs"
  },
  "devDependencies": {
    "@react-markdown-kit/renderer": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@zuilib/primitives": "0.4.0",
    "jsdom": "^25.0.1",
    "mermaid": "11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^2.1.8"
  }
}
