{
  "name": "react-markdown-kit-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "node scripts/build.mjs",
    "serve": "vite preview --outDir build",
    "typecheck": "tsc --noEmit",
    "check-theme": "node scripts/check-theme-contrast.mjs",
    "check-parts": "node scripts/check-parts.mjs"
  },
  "dependencies": {
    "@react-markdown-kit/editor": "workspace:*",
    "@react-markdown-kit/mermaid": "workspace:*",
    "@react-markdown-kit/renderer": "workspace:*",
    "@react-markdown-kit/slides": "workspace:*",
    "@react-markdown-kit/template": "workspace:*",
    "@zuilib/primitives": "0.4.0",
    "@zuilib/tokens": "0.2.1",
    "mermaid": "^11.17.2",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "github-slugger": "^2.0.0",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
