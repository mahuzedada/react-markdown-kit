{
  "name": "@react-markdown-kit/template",
  "version": "0.1.0",
  "description": "Markdown templating for React Markdown Kit, as plugins: template({ data }) resolves typed placeholders while the renderer parses; templateVariables() edits them as chips. No standalone API.",
  "homepage": "https://docs.reactmarkdownkit.com/markdown-template-engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahuzedada/react-markdown-kit.git",
    "directory": "plugins/template"
  },
  "bugs": "https://github.com/mahuzedada/react-markdown-kit/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "mdast-util-from-markdown": "^2.0.2"
  },
  "peerDependencies": {
    "@lexical/utils": "^0.35.0",
    "@react-markdown-kit/editor": "^0.1.0",
    "@react-markdown-kit/renderer": "^0.1.0",
    "lexical": "^0.35.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@lexical/utils": {
      "optional": true
    },
    "@react-markdown-kit/editor": {
      "optional": true
    },
    "lexical": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "markdown",
    "template",
    "variables",
    "personalization",
    "react",
    "plugin",
    "template-variables",
    "templating",
    "placeholders"
  ],
  "devDependencies": {
    "@lexical/utils": "^0.35.0",
    "@react-markdown-kit/editor": "workspace:*",
    "@react-markdown-kit/renderer": "workspace:*",
    "lexical": "^0.35.0"
  }
}
