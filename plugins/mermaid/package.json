{
  "name": "@react-markdown-kit/mermaid",
  "version": "0.4.0",
  "description": "Mermaid diagrams for React Markdown Kit: mermaid() turns ```mermaid fences into static SVG in the renderer and a drawing canvas in the editor, and the /canvas entry is the same canvas as a standalone component. Edits are written back as Mermaid syntax.",
  "homepage": "https://docs.reactmarkdownkit.com/docs/mermaid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahuzedada/react-markdown-kit.git",
    "directory": "plugins/mermaid"
  },
  "bugs": "https://github.com/mahuzedada/react-markdown-kit/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "DRAWING_FORMAT.md",
    "LAYOUT_ANNOTATION.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "default": "./dist/canvas.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "hast-util-to-jsx-runtime": "^2.3.2"
  },
  "peerDependencies": {
    "@lexical/utils": "^0.35.0",
    "@react-markdown-kit/editor": "^0.1.0",
    "@react-markdown-kit/renderer": "^0.1.0",
    "lexical": "^0.35.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@lexical/utils": {
      "optional": true
    },
    "@react-markdown-kit/editor": {
      "optional": true
    },
    "lexical": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "markdown",
    "diagram",
    "drawing",
    "flowchart",
    "svg",
    "react",
    "plugin",
    "mermaid",
    "mermaid-editor",
    "visual-editor",
    "flowchart-editor",
    "react-mermaid"
  ],
  "devDependencies": {
    "@lexical/utils": "^0.35.0",
    "@react-markdown-kit/editor": "workspace:*",
    "@react-markdown-kit/renderer": "workspace:*",
    "lexical": "^0.35.0"
  }
}
